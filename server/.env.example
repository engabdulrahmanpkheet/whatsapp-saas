# =============================================================================
# WhatsApp SaaS Server — environment variables
# Copy to `.env` locally. On Render/Railway set these in the dashboard.
# =============================================================================

# ----- Runtime -----
NODE_ENV=development
# PORT: Render uses 10000 internally; Railway injects its own. Leave unset on
# the platforms and override here only for local dev.
PORT=10000
LOG_LEVEL=debug                 # debug | info | warn | error
TRUST_PROXY=true                # set true behind Render / Railway / nginx
REQUEST_TIMEOUT_MS=30000

# ----- Database (MongoDB Atlas) -----
# Local:  mongodb://127.0.0.1:27017/whatsapp_saas
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/whatsapp_saas?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_saas
MONGO_POOL_SIZE=10

# ----- Security / Auth -----
# Generate strong values:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET and ADMIN_JWT_SECRET must differ and be >= 24 chars.
JWT_SECRET=replace_with_at_least_48_random_bytes_hex_for_client_jwt
JWT_EXPIRES_IN=12h

ADMIN_JWT_SECRET=replace_with_a_different_48_random_bytes_hex_for_admin_jwt
ADMIN_JWT_EXPIRES_IN=7d

# Initial admin (created by `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

# CORS — comma-separated list (use "*" only in dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Rate limits -----
RATE_GLOBAL_PER_MIN=300
RATE_AUTH_PER_10MIN=10
RATE_SEND_PER_MIN=60

# ----- Campaign defaults -----
DEFAULT_MIN_DELAY_SEC=8
DEFAULT_MAX_DELAY_SEC=20
HARD_MIN_DELAY_SEC=5

# ----- WhatsApp (Baileys) -----
WA_AUTH_STORE=mongo             # mongo (recommended) or file
WA_AUTH_DIR=./.wa-auth
WA_MAX_SESSIONS=50
WA_RECONNECT_MAX=5
WA_QR_TTL_MS=60000
WA_RESTORE_ON_BOOT=true         # rehydrate prior sessions after app.listen
