# ----- Server -----
PORT=4000
NODE_ENV=development

# Public URL of the API (used for CORS and absolute links if needed)
PUBLIC_API_URL=http://localhost:4000

# CORS — comma-separated list (use "*" only in dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- Database -----
# Local: mongodb://127.0.0.1:27017/whatsapp_saas
# Atlas: mongodb+srv://<user>:<pass>@<cluster>/whatsapp_saas?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_saas

# ----- Security -----
# Generate strong random strings:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=12h

# Admin token has its own secret + lifetime
ADMIN_JWT_SECRET=change_me_too_admin_secret
ADMIN_JWT_EXPIRES_IN=7d

# Default admin (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin123

# ----- Campaign defaults -----
DEFAULT_MIN_DELAY_SEC=8
DEFAULT_MAX_DELAY_SEC=20
HARD_MIN_DELAY_SEC=5
