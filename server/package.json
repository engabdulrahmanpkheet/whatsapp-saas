{
  "name": "whatsapp-saas-server",
  "version": "3.0.0",
  "description": "Cloud backend for WhatsApp Campaign SaaS — Baileys engine, license + queue, MongoDB Atlas",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/utils/seedAdmin.js",
    "syntax-check": "find src -name '*.js' -not -path '*/node_modules/*' -exec node --check {} +"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
